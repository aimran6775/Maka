<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime entitlements for Developer ID distribution. The bundled Node binary
       runs V8's JIT, which needs the two memory entitlements; the other two are what Node's
       own release signing uses so native behaviour matches a stock Node. The app is not
       sandboxed (direct distribution, not the App Store). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Voice (phase 4 step 14): the microphone for on-device speech recognition. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
