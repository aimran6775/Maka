{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maka",
  "version": "../package.json",
  "identifier": "com.makapark.maka",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Business",
    "copyright": "MIT. Maka is modeled on the concept and architecture of StarNet (MIT, Andrew Sims) and built from scratch.",
    "shortDescription": "A crew of AI Rangers running an online business from a living national park.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "externalBin": ["binaries/node"],
    "resources": {
      "../sidecar/": "sidecar/",
      "../shared/": "shared/",
      "../frontend/": "frontend/",
      "../package.json": "package.json",
      "../NOTICE.md": "NOTICE.md",
      "../LICENSE": "LICENSE"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  }
}
